<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="ConfigEditorWindow"
    Title="SignalRGB Pro Switcher Free"
    Width="430"
    Height="758"
    MinWidth="430"
    MaxWidth="430"
    MinHeight="758"
    MaxHeight="758"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="#0E0E12"
    Foreground="#F4F1FB"
    FontFamily="Segoe UI"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <!--
        Shared WPF resources keep presentation separate from PowerShell behavior.
        Source: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/styles-templates-overview
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0E0E12" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#17171D" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#1E1E26" />
        <SolidColorBrush x:Key="HoverBrush" Color="#272631" />
        <SolidColorBrush x:Key="BorderBrush" Color="#363440" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6253EC" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#7A6FFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F1FB" />
        <SolidColorBrush x:Key="ActiveValueBrush" Color="#C8C2D4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A19BAE" />
        <SolidColorBrush x:Key="DimBrush" Color="#716B7C" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F06C83" />
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#25242D" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#8F2638" />
            <Setter Property="BorderBrush" Value="#B0334B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B0334B" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CC4961" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="38" Height="20">
                            <Border
                                x:Name="Track"
                                Background="#2A2931"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10" />
                            <Ellipse
                                x:Name="Thumb"
                                Width="14"
                                Height="14"
                                Margin="3"
                                HorizontalAlignment="Left"
                                Fill="#C8C3D1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="9" Background="Transparent">
                            <Track
                                x:Name="PART_Track"
                                Orientation="{TemplateBinding Orientation}"
                                IsDirectionReversed="True"
                                Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5" Margin="2,0" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border
                                                    x:Name="ThumbBorder"
                                                    Background="{StaticResource MutedBrush}"
                                                    CornerRadius="3"
                                                    Opacity="0.45" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#27235E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                                x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <TextBlock
                                        Text="v"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,2"
                                        Foreground="{StaticResource MutedBrush}"
                                        FontSize="11" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="10,0,32,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade">
                                <Border
                                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                    MaxHeight="260"
                                    Margin="0,3,0,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="SegmentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#27235E" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,11,12,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="SelectionLine" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="SelectionLine" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#19181F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel
                                    IsItemsHost="True"
                                    Margin="9,0,0,0"
                                    Background="Transparent"
                                    KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter
                                Grid.Row="1"
                                ContentSource="SelectedContent"
                                KeyboardNavigation.TabIndex="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,9" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="CheckBoxBorder"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBlock
                                    x:Name="CheckMark"
                                    Text="&#x2713;"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    Margin="0,-2,0,0" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Background="{StaticResource WindowBrush}"
        BorderBrush="#403D49"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid x:Name="WindowDragArea" Grid.Row="0" Background="Transparent" Margin="12,12,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <Button
                        x:Name="TitleCloseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}"
                        Content="X"
                        Width="28"
                        Height="28"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip="Save pending changes and close" />
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                        <TextBlock
                            Text="SignalRGB Pro Switcher Free"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Text="by landnthrn"
                            Margin="8,3,0,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DimBrush}"
                            FontSize="14"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Active Effect:"
                        FontSize="11.5"
                        FontWeight="Bold"
                        TextWrapping="NoWrap"
                        Margin="0,0,10,2" />
                    <TextBlock
                        x:Name="ActiveEffectValueText"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="—"
                        FontSize="11.5"
                        FontWeight="Normal"
                        Foreground="{StaticResource ActiveValueBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,0,2" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Active Preset:"
                        FontSize="11.5"
                        FontWeight="Bold"
                        TextWrapping="NoWrap"
                        Margin="0,0,10,2" />
                    <TextBlock
                        x:Name="ActivePresetValueText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="—"
                        FontSize="11.5"
                        FontWeight="Normal"
                        Foreground="{StaticResource ActiveValueBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,0,2" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="Active Layout:"
                        FontSize="11.5"
                        FontWeight="Bold"
                        TextWrapping="NoWrap"
                        Margin="0,0,10,0" />
                    <TextBlock
                        x:Name="ActiveLayoutValueText"
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="—"
                        FontSize="11.5"
                        FontWeight="Normal"
                        Foreground="{StaticResource ActiveValueBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource TabControlStyle}">
                <TabItem Header="Effects" Style="{StaticResource TabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,8,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="EffectsCountText"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MutedBrush}"
                                FontSize="11" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ToggleAllEffectsButton" Content="Expand/Collapse" Style="{StaticResource SmallButtonStyle}" Height="34" />
                                <Button x:Name="EffectsFilterButton" Style="{StaticResource SmallButtonStyle}" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="Filter effects">
                                    <Viewbox Width="13" Height="13">
                                        <Path Fill="{StaticResource TextBrush}" Data="M2,3 L14,3 L9,8 L9,13 L7,14 L7,8 Z" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer
                            x:Name="EffectsScrollViewer"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="14,2,14,12">
                            <StackPanel x:Name="EffectsPanel" />
                        </ScrollViewer>
                        <Border
                            x:Name="EffectsFilterDismissLayer"
                            Grid.RowSpan="2"
                            Background="#01000000"
                            IsHitTestVisible="True"
                            Panel.ZIndex="19"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="EffectsFilterPanel"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="292"
                            Margin="0,48,14,0"
                            Padding="10,10,10,9"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Panel.ZIndex="20"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Filters" Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" />
                                <CheckBox x:Name="EffectsFilterCustomOrderCheck" Content="Custom order" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterAzCheck" Content="A-Z" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterMostPresetsCheck" Content="Most presets" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterLeastPresetsCheck" Content="Least presets" Style="{StaticResource FilterCheckBoxStyle}" />
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,2,0,10" />
                                <CheckBox x:Name="EffectsFilterAssignedLayoutsCheck" Content="Assigned layouts" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterSpecificLayoutCheck" Content="Specific assigned layout" Style="{StaticResource FilterCheckBoxStyle}" />
                                <ComboBox x:Name="EffectsFilterSpecificLayoutComboBox" Height="32" Margin="18,-2,0,8" />
                                <CheckBox x:Name="EffectsFilterNoAssignedLayoutsCheck" Content="No assigned layouts" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterFavoritesCheck" Content="Favorites" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterIgnoredLastCheck" Content="Display ignored last" Style="{StaticResource FilterCheckBoxStyle}" />
                                <CheckBox x:Name="EffectsFilterIgnoredFirstCheck" Content="Display ignored first" Style="{StaticResource FilterCheckBoxStyle}" />
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,2,0,10" />
                                <TextBlock Text="Special" Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Set current filter(s) results as your custom order"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button x:Name="EffectsFilterSetOrderButton" Grid.Column="1" Content="Set" Style="{StaticResource SmallButtonStyle}" Width="58" Height="30" Margin="9,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Revert back to your custom order" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button x:Name="EffectsFilterRevertOrderButton" Grid.Column="1" Content="Revert" Style="{StaticResource SmallButtonStyle}" Width="58" Height="30" Margin="9,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Layouts" Style="{StaticResource TabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,8,14,4">
                            <TextBlock
                                x:Name="LayoutsCountText"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MutedBrush}"
                                FontSize="11" />
                        </Grid>
                        <ScrollViewer
                            x:Name="LayoutsScrollViewer"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="14,2,14,12">
                            <StackPanel x:Name="LayoutsPanel" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Cycling" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,6,16,18">
                            <TextBlock Text="DISCLAIMER" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Your cursor may do a loading animation when effects/presets change"
                                       Foreground="{StaticResource MutedBrush}" FontStyle="Italic" FontSize="11.4"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="EFFECT CYCLING" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Height="42">
                                <TextBlock Text="Enable effect cycling" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="EffectCyclingEnabledToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="EffectCyclingOrderRadio" GroupName="EffectCyclingMode" Content="Cycle in set order" Style="{StaticResource SegmentRadioStyle}" />
                                <RadioButton x:Name="EffectCyclingRandomRadio" Grid.Row="2" GroupName="EffectCyclingMode" Content="Cycle by random order" Style="{StaticResource SegmentRadioStyle}" />
                            </Grid>
                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cycle effect once all presets elapsed"
                                           Style="{StaticResource FieldLabelStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,10,0" />
                                <ToggleButton x:Name="CycleEffectOnceAllPresetsElapsedToggle"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <TextBlock Text="Requires preset cycling enabled"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10.4"
                                       Margin="0,-4,0,8" />
                            <Grid Height="42">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Cycle interval" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="EffectCyclingIntervalValidationText" Grid.Column="1"
                                           Text="Invalid entry." Foreground="{StaticResource ErrorBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBox x:Name="EffectCyclingIntervalTextBox" Grid.Column="2" />
                            </Grid>

                            <TextBlock Text="PRESET CYCLING" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Height="42">
                                <TextBlock Text="Enable effect preset cycling" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="PresetCyclingEnabledToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="PresetCyclingOrderRadio" GroupName="PresetCyclingMode" Content="Cycle in set order" Style="{StaticResource SegmentRadioStyle}" />
                                <RadioButton x:Name="PresetCyclingRandomRadio" Grid.Row="2" GroupName="PresetCyclingMode" Content="Cycle by random order" Style="{StaticResource SegmentRadioStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Cycle interval" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="PresetCyclingIntervalValidationText" Grid.Column="1"
                                           Text="Invalid entry." Foreground="{StaticResource ErrorBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBox x:Name="PresetCyclingIntervalTextBox" Grid.Column="2" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Hotkeys" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,6,16,18">
                            <TextBlock Text="MENU" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Picker menu" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="OpenPickerMenuTextBox" Grid.Column="1" />
                            </Grid>

                            <TextBlock Text="PICKERS" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pick preset" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PickPresetTextBox" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pick effect" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PickEffectTextBox" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pick layout" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PickLayoutTextBox" Grid.Column="1" />
                            </Grid>

                            <TextBlock Text="GO TO NEXT" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Go to next preset" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NextPresetTextBox" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Go to next effect" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NextEffectTextBox" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Go to next layout" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NextLayoutTextBox" Grid.Column="1" />
                            </Grid>

                            <TextBlock Text="UTILITY" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Show current status" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="ShowStatusTextBox" Grid.Column="1" />
                            </Grid>
                            <TextBlock
                                x:Name="HotkeyWarningText"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,3,0,0"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Settings" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,6,16,20">
                            <TextBlock Text="GENERAL" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Height="42">
                                <TextBlock Text="Launch on startup" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="LaunchOnStartupToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Show hotkey tooltip/notifications" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="ShowHotkeyNotificationsToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Auto-update inventory" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="AutoUpdateInventoryToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Update interval" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="AutoUpdateInventoryIntervalValidationText" Grid.Column="1"
                                           Text="Invalid entry." Foreground="{StaticResource ErrorBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBox x:Name="AutoUpdateInventoryIntervalTextBox" Grid.Column="2" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Watch for effect changes &amp; apply config behavior" Width="285" HorizontalAlignment="Left" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="WatchExternalEffectChangesToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Apply config to active effect on .ahk startup" Width="285" HorizontalAlignment="Left" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="ApplyPoliciesOnStartupToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Remember last active effect/preset on .ahk startups"
                                           HorizontalAlignment="Left"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,48,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="RememberLastActiveEffectPresetToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Exclude ignored from pickers" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="ExcludeFromPickersToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Exclude ignored from go to next hotkeys" Width="285" HorizontalAlignment="Left" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="ExcludeFromNextHotkeysToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                            <Grid Height="42">
                                <TextBlock Text="Exclude ignored from cycling effects/presets" Width="285" HorizontalAlignment="Left" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="ExcludeFromCyclingToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>

                            <TextBlock Text="EFFECT ACTIVATION" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Preset used when an effect activates" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,7" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="PresetLastUsedRadio" GroupName="PresetActivation" Content="Last used" Style="{StaticResource SegmentRadioStyle}" />
                                <RadioButton x:Name="PresetPreferredRadio" Grid.Column="2" GroupName="PresetActivation" Content="First in set order" Style="{StaticResource SegmentRadioStyle}" />
                            </Grid>
                            <TextBlock x:Name="PresetActivationOverrideText"
                                       Text="Overridden while preset cycling is enabled."
                                       Foreground="{StaticResource ErrorBrush}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,-1,0,7"
                                       Visibility="Collapsed" />

                            <TextBlock Text="LAYOUT RULES" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="For effects without an assigned layout" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,7" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="KeepCurrentLayoutRadio" GroupName="UnassignedLayout" Content="Keep current" Style="{StaticResource SegmentRadioStyle}" />
                                <RadioButton x:Name="UseDefaultLayoutRadio" Grid.Column="2" GroupName="UnassignedLayout" Content="Use default" Style="{StaticResource SegmentRadioStyle}" />
                            </Grid>
                            <TextBlock Text="Default layout" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                            <ComboBox x:Name="DefaultLayoutComboBox" />

                            <TextBlock Text="CONFIG FILE" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="ImportConfigButton" Content="Import config" Style="{StaticResource BaseButtonStyle}" Height="34" />
                                <Button x:Name="ExportConfigButton" Grid.Column="2" Content="Export config" Style="{StaticResource BaseButtonStyle}" Height="34" />
                            </Grid>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,22,0,0">
                                <StackPanel>
                                    <Button x:Name="AdvancedToggleButton" Style="{StaticResource BaseButtonStyle}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Advanced settings" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AdvancedToggleArrow" Grid.Column="1" Text="v" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="AdvancedSettingsPanel" Visibility="Collapsed" Margin="10,0,10,10">
                                        <Grid Height="46">
                                            <TextBlock Text="Logging" Style="{StaticResource FieldLabelStyle}" />
                                            <ToggleButton x:Name="LoggingToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" />
                                        </Grid>
                                        <TextBlock Text="Inventory file" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,6" />
                                        <TextBox x:Name="InventoryFileTextBox" />
                                        <TextBlock Text="Updater script" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,6" />
                                        <TextBox x:Name="UpdaterScriptTextBox" />
                                        <TextBlock Text="RESET TO DEFAULTS" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,8" />
                                        <Button x:Name="ResetInventoryButton" Content="Reset/Clear Inventory" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,0,8" />
                                        <Button x:Name="ResetEffectsButton" Content="Reset effects tab" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,0,8" />
                                        <Button x:Name="ResetLayoutsButton" Content="Reset layouts tab" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,0,8" />
                                        <Button x:Name="ResetCyclingButton" Content="Reset cycling tab" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,0,8" />
                                        <Button x:Name="ResetHotkeysButton" Content="Reset hotkeys" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,0,8" />
                                        <Button x:Name="ResetSettingsButton" Content="Reset settings" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,0,8" />
                                        <Button x:Name="ResetConfigButton" Content="Reset whole config" Style="{StaticResource DangerButtonStyle}" Height="34" Padding="12,7" Margin="0,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#121217">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource DimBrush}"
                        FontSize="11"
                        Text="Showing current" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdateInventoryButton" Content="Update inventory" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0" />
                        <Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
